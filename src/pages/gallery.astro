---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { clinic } from '../data/clinic';
import { hasGallery } from '../utils/visibility';
import { getClinicBookingWhatsAppLink } from '../utils/whatsapp';
import { getCollection } from 'astro:content';

let allGalleryItems: any[] = [];
try {
  allGalleryItems = await getCollection('gallery');
} catch {
  allGalleryItems = [];
}

const approvedGalleryItems = allGalleryItems
  .filter((item) => item.data.consentConfirmed === true)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const isGalleryActive = hasGallery(approvedGalleryItems);

const breadcrumbs = [
  { label: 'Gallery' }
];

const breadcrumbsJsonLd = [
  { name: 'Home', item: '/' },
  { name: 'Gallery', item: '/gallery/' }
];

const pageTitle = `Clinical Gallery | ${clinic.name} DG Khan`;
const pageDescription = `Real clinical results and facility images from Glow & Grace Aesthetics in Dera Ghazi Khan. Published strictly with verified patient consent.`;
const waBookingLink = getClinicBookingWhatsAppLink();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbsJsonLd={breadcrumbsJsonLd}
  noindex={!isGalleryActive}
>
  <!-- Hero Section -->
  <header class="gallery-hero-section section">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <div class="gallery-hero-content">
        <span class="eyebrow">ETHICAL CLINICAL PHOTOGRAPHY</span>
        <h1 class="page-title">Clinic & Treatment Gallery</h1>
        <p class="lead-text">
          At Glow & Grace Aesthetics, we believe in authentic transparency. Every clinical result in our gallery is published strictly with explicit, informed patient consent. We never use stock photos or unverified imagery.
        </p>
      </div>
    </div>
  </header>

  <!-- Gallery Body -->
  <section class="section gallery-body-section" aria-label="Gallery Showcase">
    <div class="container">
      {!isGalleryActive && (
        <div class="gallery-empty-state card-base">
          <div class="empty-state-icon" aria-hidden="true">
            <Icon name="shield-check" size={40} />
          </div>
          <h2 class="empty-state-title">Patient Privacy &amp; Ethical Standards</h2>
          <p class="empty-state-desc">
            We hold medical confidentiality to the highest clinical bar. Patient before-and-after photographs are published only when verified, signed consent is on record.
          </p>
          <p class="empty-state-sub">
            During your private, in-person consultation at our clinic in Dera Ghazi Khan, our doctor can share relevant anonymised clinical portfolio cases directly with you to help guide your expectations.
          </p>
          <div class="empty-state-actions">
            <Button
              href="/book-appointment/"
              variant="primary"
              size="md"
              icon="calendar"
            >
              Book In-Person Consultation
            </Button>
            <Button
              href="/services/"
              variant="secondary"
              size="md"
              icon="arrow-right"
            >
              Browse All Services
            </Button>
          </div>
        </div>
      )}

      {isGalleryActive && (
        <div class="active-gallery-wrap">
          <div class="gallery-filter-chips" role="tablist" aria-label="Gallery Filters">
            <button type="button" class="gallery-chip-btn is-active" data-kind="all">All Items</button>
            <button type="button" class="gallery-chip-btn" data-kind="clinic">Clinic Facility</button>
            <button type="button" class="gallery-chip-btn" data-kind="equipment">Equipment</button>
            <button type="button" class="gallery-chip-btn" data-kind="result">Clinical Results</button>
          </div>

          <div class="gallery-grid" id="gallery-grid">
            {approvedGalleryItems.map((item, index) => (
              <div
                class="gallery-card card-base"
                data-kind={item.data.kind}
                data-index={index}
              >
                <div class="gallery-image-wrap">
                  {item.data.image ? (
                    <img
                      src={item.data.image}
                      alt={item.data.alt || item.data.title}
                      loading="lazy"
                      class="gallery-thumb"
                    />
                  ) : item.data.beforeImage && item.data.afterImage ? (
                    <div class="before-after-split">
                      <img src={item.data.beforeImage} alt="Before treatment" loading="lazy" class="split-img" />
                      <img src={item.data.afterImage} alt="After treatment" loading="lazy" class="split-img" />
                    </div>
                  ) : null}
                  <button
                    type="button"
                    class="lightbox-trigger-btn"
                    aria-label={`View enlarged image for ${item.data.title}`}
                    data-title={item.data.title}
                    data-caption={item.data.caption || ''}
                    data-img={item.data.image || item.data.afterImage}
                  >
                    <Icon name="search" size={20} />
                  </button>
                </div>
                <div class="gallery-meta">
                  <span class="gallery-kind-badge">{item.data.kind}</span>
                  <h3 class="gallery-item-title">{item.data.title}</h3>
                  {item.data.caption && <p class="gallery-caption">{item.data.caption}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Accessible Modal Lightbox Dialog -->
  <dialog id="gallery-lightbox" class="lightbox-dialog" aria-label="Image preview">
    <div class="lightbox-content">
      <button type="button" id="lightbox-close" class="lightbox-close-btn" aria-label="Close dialog">
        <Icon name="x" size={24} />
      </button>
      <div class="lightbox-image-container">
        <img id="lightbox-img" src="" alt="" class="lightbox-full-img" />
      </div>
      <div class="lightbox-info">
        <h3 id="lightbox-title" class="lightbox-title"></h3>
        <p id="lightbox-caption" class="lightbox-caption"></p>
      </div>
    </div>
  </dialog>

  <!-- CTA Band -->
  <CtaBand
    title="Ready to discuss your aesthetic goals?"
    subtitle="Book an in-person evaluation with our doctor at YCDO Ghazi National Hospital, Dera Ghazi Khan."
    primaryHref="/book-appointment/"
    primaryText="Book Appointment"
    secondaryHref={waBookingLink}
    secondaryText="Chat on WhatsApp"
  />
</BaseLayout>

<script>
  function initGalleryLightbox() {
    const dialog = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('lightbox-close');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const triggers = document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger-btn');
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.gallery-chip-btn');
    const cards = document.querySelectorAll<HTMLElement>('.gallery-card');

    // Filter handling
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const kind = btn.getAttribute('data-kind');

        cards.forEach((card) => {
          if (kind === 'all' || card.getAttribute('data-kind') === kind) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Lightbox modal handling
    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        if (!dialog || !lightboxImg) return;
        const src = trigger.getAttribute('data-img') || '';
        const title = trigger.getAttribute('data-title') || '';
        const caption = trigger.getAttribute('data-caption') || '';

        lightboxImg.src = src;
        lightboxImg.alt = title;
        if (lightboxTitle) lightboxTitle.textContent = title;
        if (lightboxCaption) lightboxCaption.textContent = caption;

        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => {
      dialog?.close();
    });

    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) {
        dialog.close();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGalleryLightbox);
  } else {
    initGalleryLightbox();
  }
</script>

<style>
  .gallery-hero-section {
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(32px, 5vw, 48px);
    background-color: var(--green-50);
    border-bottom: 1px solid var(--sand-200);
  }

  .gallery-hero-content {
    max-width: 820px;
  }

  .page-title {
    font-size: var(--text-h1);
    color: var(--green-900);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .lead-text {
    font-size: clamp(1.05rem, 1.2vw + 0.5rem, 1.15rem);
    line-height: 1.65;
    color: var(--text-body);
    margin: 0;
  }

  /* Gallery Body */
  .gallery-body-section {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* Empty State */
  .gallery-empty-state {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--sand-300);
    border-radius: var(--radius-lg);
    background-color: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .empty-state-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    background-color: var(--green-50);
    color: var(--green-800);
    margin-bottom: 1.5rem;
    border: 1px solid var(--green-200);
  }

  .empty-state-title {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    color: var(--green-900);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .empty-state-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 1rem;
  }

  .empty-state-sub {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .empty-state-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  /* Active Gallery */
  .gallery-filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 2.5rem;
    justify-content: center;
  }

  .gallery-chip-btn {
    appearance: none;
    background-color: var(--sand-100);
    color: var(--green-900);
    border: 1px solid var(--sand-300);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .gallery-chip-btn.is-active {
    background-color: var(--green-900);
    color: var(--white);
    border-color: var(--green-900);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-card {
    background-color: var(--white);
    border: 1px solid var(--sand-200);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .gallery-image-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    background-color: var(--sand-100);
    overflow: hidden;
  }

  .gallery-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .before-after-split {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .split-img {
    width: 50%;
    height: 100%;
    object-fit: cover;
  }

  .lightbox-trigger-btn {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.9);
    color: var(--green-900);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-fast);
  }

  .lightbox-trigger-btn:hover {
    background-color: var(--green-900);
    color: var(--white);
  }

  .gallery-meta {
    padding: 1.25rem;
  }

  .gallery-kind-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--green-700);
  }

  .gallery-item-title {
    font-size: 1.1rem;
    color: var(--green-900);
    margin: 0.25rem 0 0.5rem;
  }

  .gallery-caption {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Lightbox Dialog */
  .lightbox-dialog {
    border: none;
    border-radius: var(--radius-lg);
    padding: 0;
    max-width: min(800px, 90vw);
    background: transparent;
    overflow: hidden;
  }

  .lightbox-dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }

  .lightbox-content {
    background-color: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
  }

  .lightbox-close-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background-color: rgba(0, 0, 0, 0.6);
    color: var(--white);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  .lightbox-full-img {
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    background-color: #000;
    display: block;
  }

  .lightbox-info {
    padding: 1.25rem 1.5rem;
  }

  .lightbox-title {
    font-size: 1.2rem;
    color: var(--green-900);
    margin-bottom: 0.35rem;
  }

  .lightbox-caption {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
