---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { clinic } from '../data/clinic';
import { categories } from '../data/categories';
import { getClinicBookingWhatsAppLink, getClinicTelLink } from '../utils/whatsapp';
import { getTodayInKarachi } from '../utils/booking';
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');

// Group services by category order
const servicesByCategory = categories.map((cat) => {
  const services = allServices
    .filter((s) => s.data.category === cat.slug)
    .sort((a, b) => a.data.order - b.data.order);
  return {
    ...cat,
    services
  };
});

const todayInKarachi = getTodayInKarachi();

const breadcrumbs = [
  { label: 'Book Appointment' }
];

const breadcrumbsJsonLd = [
  { name: 'Home', item: '/' },
  { name: 'Book Appointment', item: '/book-appointment/' }
];

const pageTitle = `Request an Appointment | ${clinic.name} DG Khan`;
const pageDescription = `Book your medical aesthetic consultation at Glow & Grace Aesthetics in Dera Ghazi Khan. Select your treatment, preferred date, and connect directly on WhatsApp.`;
const waDirectLink = getClinicBookingWhatsAppLink();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbsJsonLd={breadcrumbsJsonLd}
>
  <!-- Header -->
  <header class="booking-hero-section section">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <div class="booking-hero-grid">
        <div class="booking-hero-content">
          <span class="eyebrow">ONLINE APPOINTMENT REQUEST</span>
          <h1 class="page-title">Book Your Clinic Visit</h1>
          <p class="lead-text">
            Choose your preferred treatment and date below. Completing this form will generate a prefilled appointment message on WhatsApp directly to our clinic desk for confirmation.
          </p>

          <div class="booking-notice-card">
            <Icon name="clock" size={20} class="notice-icon" />
            <div>
              <strong>Clinic Hours:</strong> Monday to Saturday, 10:00 AM to 10:00 PM. Closed on Sundays.
            </div>
          </div>
        </div>

        <!-- Quick Help Card -->
        <div class="booking-quick-help card-base">
          <h2 class="help-title">Prefer to book by phone?</h2>
          <p class="help-text">
            You can call our clinic desk directly or send a message on WhatsApp without filling out this form.
          </p>
          <div class="help-actions">
            <Button
              href={getClinicTelLink()}
              variant="secondary"
              size="md"
              icon="phone"
              class="w-full mb-2"
            >
              Call {clinic.phone.display}
            </Button>
            <Button
              href={waDirectLink}
              target="_blank"
              variant="ghost"
              size="md"
              icon="whatsapp"
              class="w-full"
            >
              Direct WhatsApp Message
            </Button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Booking Form Section -->
  <section class="section booking-form-section" aria-label="Appointment Request Form">
    <div class="container">
      <div class="form-wrapper-outer">
        <div class="booking-form-card card-base">
          <!-- Accessibility Error Summary -->
          <div
            id="error-summary"
            class="error-summary-box"
            role="alert"
            tabindex="-1"
            style="display: none;"
          >
            <div class="error-summary-title">
              <Icon name="shield-alert" size={20} />
              <span>Please review the following items:</span>
            </div>
            <ul id="error-summary-list" class="error-summary-list" role="list"></ul>
          </div>

          <form id="appointment-form" class="appointment-form" novalidate>
            <!-- 1. Full Name -->
            <div class="form-group" id="group-name">
              <label for="patient-name" class="form-label">
                Full Name <span class="required-indicator" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="patient-name"
                name="name"
                class="form-input"
                placeholder="e.g. Fatima Ali or Muhammad Usman"
                required
                autocomplete="name"
              />
              <span class="field-error-msg" id="error-name" style="display: none;"></span>
            </div>

            <!-- 2. Treatment Selection -->
            <div class="form-group" id="group-service">
              <label for="service-select" class="form-label">
                Select Treatment or Consultation <span class="required-indicator" aria-hidden="true">*</span>
              </label>
              <div class="select-wrapper">
                <select id="service-select" name="service" class="form-select" required>
                  <option value="" disabled selected>-- Choose a treatment or consultation --</option>
                  <option value="General Aesthetic Consultation">General Aesthetic Consultation (Doctor Assessment)</option>
                  {servicesByCategory.map((category) => (
                    <optgroup label={category.name}>
                      {category.services.map((service) => (
                        <option value={service.data.title} data-slug={service.id.replace(/\.md$/, '')}>
                          {service.data.title}
                        </option>
                      ))}
                    </optgroup>
                  ))}
                </select>
                <Icon name="chevron-down" size={16} class="select-chevron" />
              </div>
              <span class="field-error-msg" id="error-service" style="display: none;"></span>
            </div>

            <!-- 3. Preferred Date & Time Row -->
            <div class="form-row-2col">
              <div class="form-group" id="group-date">
                <label for="booking-date" class="form-label">
                  Preferred Date <span class="required-indicator" aria-hidden="true">*</span>
                </label>
                <input
                  type="date"
                  id="booking-date"
                  name="date"
                  class="form-input"
                  min={todayInKarachi}
                  required
                />
                <span class="field-hint">Monday to Saturday only (Sundays closed).</span>
                <span class="field-error-msg" id="error-date" style="display: none;"></span>
              </div>

              <div class="form-group" id="group-time">
                <label for="booking-time" class="form-label">
                  Preferred Time Slot <span class="required-indicator" aria-hidden="true">*</span>
                </label>
                <div class="select-wrapper">
                  <select id="booking-time" name="time" class="form-select" required>
                    <option value="" disabled selected>-- Select a preferred slot --</option>
                    <option value="Morning (10:00 AM - 1:00 PM)">Morning (10:00 AM - 1:00 PM)</option>
                    <option value="Afternoon (1:00 PM - 5:00 PM)">Afternoon (1:00 PM - 5:00 PM)</option>
                    <option value="Evening (5:00 PM - 9:30 PM)">Evening (5:00 PM - 9:30 PM)</option>
                  </select>
                  <Icon name="chevron-down" size={16} class="select-chevron" />
                </div>
                <span class="field-error-msg" id="error-time" style="display: none;"></span>
              </div>
            </div>

            <!-- 4. Notes / Concerns -->
            <div class="form-group" id="group-notes">
              <div class="label-with-counter">
                <label for="booking-notes" class="form-label">
                  Additional Notes or Questions <span class="optional-tag">(Optional)</span>
                </label>
                <span id="notes-counter" class="char-counter">0 / 300</span>
              </div>
              <textarea
                id="booking-notes"
                name="note"
                class="form-textarea"
                rows="3"
                maxlength="300"
                placeholder="Mention specific concerns, past treatments, or timing preferences..."
              ></textarea>
              <span class="field-error-msg" id="error-notes" style="display: none;"></span>
            </div>

            <!-- Submit Button -->
            <div class="form-submit-wrap">
              <button
                type="submit"
                id="submit-appointment-btn"
                class="btn btn-primary btn-lg w-full submit-booking-btn"
              >
                <Icon name="whatsapp" size={20} class="btn-icon" />
                <span>Confirm on WhatsApp &rarr;</span>
              </button>
              <p class="submit-privacy-note">
                Tapping this button will open WhatsApp with your prefilled appointment details. No payment is required until your clinical consultation.
              </p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { isValidBookingDate, buildAppointmentWhatsAppUrl } from '../utils/booking';

  function initAppointmentForm() {
    const form = document.getElementById('appointment-form') as HTMLFormElement | null;
    if (!form) return;

    const nameInput = document.getElementById('patient-name') as HTMLInputElement | null;
    const serviceSelect = document.getElementById('service-select') as HTMLSelectElement | null;
    const dateInput = document.getElementById('booking-date') as HTMLInputElement | null;
    const timeSelect = document.getElementById('booking-time') as HTMLSelectElement | null;
    const notesTextarea = document.getElementById('booking-notes') as HTMLTextAreaElement | null;
    const notesCounter = document.getElementById('notes-counter');
    const errorSummary = document.getElementById('error-summary');
    const errorList = document.getElementById('error-summary-list');

    // 1. Auto-select service if ?service=<slug> is in URL
    const params = new URLSearchParams(window.location.search);
    const serviceSlug = params.get('service');
    if (serviceSlug && serviceSelect) {
      const matchingOption = Array.from(serviceSelect.options).find(
        (opt) => opt.getAttribute('data-slug') === serviceSlug || opt.value.toLowerCase().includes(serviceSlug.toLowerCase())
      );
      if (matchingOption) {
        serviceSelect.value = matchingOption.value;
      }
    }

    // 2. Character counter for notes
    notesTextarea?.addEventListener('input', () => {
      const len = notesTextarea.value.length;
      if (notesCounter) {
        notesCounter.textContent = `${len} / 300`;
      }
    });

    // Helper: show field error
    function setFieldError(fieldId: string, errorId: string, message: string) {
      const inputEl = document.getElementById(fieldId);
      const errorEl = document.getElementById(errorId);
      if (inputEl) {
        inputEl.classList.add('is-invalid');
        inputEl.setAttribute('aria-invalid', 'true');
        inputEl.setAttribute('aria-describedby', errorId);
      }
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.style.display = 'block';
      }
    }

    // Helper: clear field error
    function clearFieldError(fieldId: string, errorId: string) {
      const inputEl = document.getElementById(fieldId);
      const errorEl = document.getElementById(errorId);
      if (inputEl) {
        inputEl.classList.remove('is-invalid');
        inputEl.removeAttribute('aria-invalid');
        inputEl.removeAttribute('aria-describedby');
      }
      if (errorEl) {
        errorEl.textContent = '';
        errorEl.style.display = 'none';
      }
    }

    // 3. Form submit handler
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Clear previous errors
      clearFieldError('patient-name', 'error-name');
      clearFieldError('service-select', 'error-service');
      clearFieldError('booking-date', 'error-date');
      clearFieldError('booking-time', 'error-time');
      clearFieldError('booking-notes', 'error-notes');
      if (errorSummary) errorSummary.style.display = 'none';
      if (errorList) errorList.innerHTML = '';

      const errors: Array<{ fieldId: string; errorId: string; message: string }> = [];

      // Validate Name
      const name = nameInput?.value.trim() || '';
      if (!name) {
        errors.push({
          fieldId: 'patient-name',
          errorId: 'error-name',
          message: 'Please enter your full name.'
        });
      }

      // Validate Service
      const service = serviceSelect?.value || '';
      if (!service) {
        errors.push({
          fieldId: 'service-select',
          errorId: 'error-service',
          message: 'Please select a treatment or general consultation.'
        });
      }

      // Validate Date
      const dateVal = dateInput?.value || '';
      const dateCheck = isValidBookingDate(dateVal);
      if (!dateCheck.valid) {
        errors.push({
          fieldId: 'booking-date',
          errorId: 'error-date',
          message: dateCheck.reason || 'Please select a valid booking date.'
        });
      }

      // Validate Time
      const timeVal = timeSelect?.value || '';
      if (!timeVal) {
        errors.push({
          fieldId: 'booking-time',
          errorId: 'error-time',
          message: 'Please select a preferred time slot.'
        });
      }

      // Handle Errors
      if (errors.length > 0) {
        if (errorSummary && errorList) {
          errorList.innerHTML = '';
          errors.forEach((err) => {
            setFieldError(err.fieldId, err.errorId, err.message);
            const li = document.createElement('li');
            const link = document.createElement('a');
            link.href = `#${err.fieldId}`;
            link.textContent = err.message;
            link.addEventListener('click', (ev) => {
              ev.preventDefault();
              document.getElementById(err.fieldId)?.focus();
            });
            li.appendChild(link);
            errorList.appendChild(li);
          });
          errorSummary.style.display = 'block';
          errorSummary.focus();
        }
        return;
      }

      // If valid, build WhatsApp URL
      const noteVal = notesTextarea?.value.trim() || undefined;
      const waUrl = buildAppointmentWhatsAppUrl({
        name,
        service,
        date: dateVal,
        time: timeVal,
        note: noteVal
      });

      // Redirect to WhatsApp
      window.location.href = waUrl;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAppointmentForm);
  } else {
    initAppointmentForm();
  }
</script>

<style>
  .booking-hero-section {
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(32px, 5vw, 48px);
    background-color: var(--green-50);
    border-bottom: 1px solid var(--sand-200);
  }

  .booking-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .booking-hero-grid {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 3.5rem;
    }
  }

  .page-title {
    font-size: var(--text-h1);
    color: var(--green-900);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .lead-text {
    font-size: clamp(1.05rem, 1.2vw + 0.5rem, 1.15rem);
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 1.5rem;
    max-width: 60ch;
  }

  .booking-notice-card {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.9rem 1.15rem;
    background-color: var(--white);
    border: 1px solid var(--sand-300);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    color: var(--green-900);
    max-width: 520px;
  }

  .notice-icon {
    color: var(--green-700);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .booking-quick-help {
    padding: clamp(1.5rem, 3vw, 2rem);
    background-color: var(--white);
    border: 1px solid var(--sand-300);
    border-radius: var(--radius-lg);
  }

  .help-title {
    font-size: 1.15rem;
    color: var(--green-900);
    margin-bottom: 0.5rem;
  }

  .help-text {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  /* Form Section */
  .booking-form-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .form-wrapper-outer {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .booking-form-card {
    padding: clamp(1.75rem, 4vw, 3rem);
    background-color: var(--white);
    border: 1px solid var(--sand-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  /* Error Summary */
  .error-summary-box {
    padding: 1.25rem 1.5rem;
    background-color: #FEF2F2;
    border: 1px solid #F87171;
    border-radius: var(--radius-md);
    margin-bottom: 2rem;
    outline: none;
  }

  .error-summary-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #991B1B;
    margin-bottom: 0.5rem;
  }

  .error-summary-list {
    margin: 0;
    padding-left: 1.5rem;
    font-size: 0.875rem;
    color: #B91C1C;
  }

  .error-summary-list li {
    margin-bottom: 0.25rem;
  }

  .error-summary-list a {
    color: #991B1B;
    text-decoration: underline;
  }

  /* Form Elements */
  .appointment-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-row-2col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .form-row-2col {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .form-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--green-900);
  }

  .required-indicator {
    color: #DC2626;
  }

  .optional-tag {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .label-with-counter {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .char-counter {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    font-size: 1rem;
    color: var(--green-900);
    background-color: var(--sand-50);
    border: 1px solid var(--sand-300);
    border-radius: var(--radius-md);
    outline: none;
    font-family: inherit;
    transition: var(--transition-fast);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    background-color: var(--white);
    border-color: var(--green-700);
    box-shadow: 0 0 0 3px rgba(31, 122, 90, 0.15);
  }

  .form-input.is-invalid,
  .form-select.is-invalid,
  .form-textarea.is-invalid {
    border-color: #DC2626;
    background-color: #FEF2F2;
  }

  .select-wrapper {
    position: relative;
  }

  .form-select {
    appearance: none;
    padding-right: 2.5rem;
    cursor: pointer;
  }

  .select-chevron {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .field-hint {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .field-error-msg {
    font-size: 0.8125rem;
    color: #DC2626;
    font-weight: 500;
  }

  .form-submit-wrap {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .submit-booking-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 1.5rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .submit-privacy-note {
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.45;
    margin: 0;
  }
</style>
