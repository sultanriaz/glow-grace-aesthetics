---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'whatsapp' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconPosition?: 'left' | 'right';
  target?: string;
  rel?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  ariaLabel?: string;
  id?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'left',
  target,
  rel,
  class: className = '',
  type = 'button',
  ariaLabel,
  id
} = Astro.props;

// Auto-add rel="noopener noreferrer" for external targets
const computedRel = rel || (target === '_blank' ? 'noopener noreferrer' : undefined);
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={!href ? type : undefined}
  target={target}
  rel={computedRel}
  class={`btn btn-${variant} btn-${size} ${className}`.trim()}
  aria-label={ariaLabel}
  id={id}
>
  {icon && iconPosition === 'left' && (
    <Icon name={icon} size={size === 'sm' ? 16 : size === 'lg' ? 22 : 18} />
  )}
  <span class="btn-text"><slot /></span>
  {icon && iconPosition === 'right' && (
    <Icon name={icon} size={size === 'sm' ? 16 : size === 'lg' ? 22 : 18} />
  )}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-full);
    min-height: var(--touch-target-min);
    cursor: pointer;
    line-height: 1;
    white-space: nowrap;
    border: 1px solid transparent;
    transition: transform var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), color var(--transition-fast);
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .btn:active {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover {
      transform: none;
    }
  }

  /* Sizes */
  .btn-sm {
    padding: 0.45rem 1rem;
    font-size: var(--text-xs);
    min-height: 38px;
  }

  .btn-md {
    padding: 0.7rem 1.5rem;
    font-size: var(--text-sm);
    min-height: 46px;
  }

  .btn-lg {
    padding: 0.95rem 2rem;
    font-size: 1.0625rem;
    min-height: 52px;
  }

  /* Variants */
  .btn-primary {
    background-color: var(--green-900);
    color: var(--white);
    border-color: var(--green-900);
  }
  .btn-primary:hover {
    background-color: var(--color-primary-hover);
    color: var(--white);
  }

  .btn-secondary {
    background-color: var(--white);
    color: var(--green-900);
    border-color: var(--sand-400);
  }
  .btn-secondary:hover {
    background-color: var(--green-50);
    border-color: var(--green-700);
    color: var(--green-900);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--green-900);
    border-color: var(--green-900);
  }
  .btn-outline:hover {
    background-color: var(--green-900);
    color: var(--white);
  }

  .btn-ghost {
    background-color: transparent;
    color: var(--green-700);
    border-color: transparent;
    box-shadow: none;
  }
  .btn-ghost:hover {
    color: var(--green-900);
    background-color: var(--green-50);
    box-shadow: none;
  }

  .btn-whatsapp {
    background-color: var(--green-900);
    color: var(--white);
    border-color: var(--green-900);
  }
  .btn-whatsapp:hover {
    background-color: #022F22;
    color: var(--white);
  }
</style>
