---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { getMapDirectionsUrl, getMapSearchUrl, getMapEmbedUrl } from '../utils/maps';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const searchUrl = getMapSearchUrl();
const directionsUrl = getMapDirectionsUrl();
const embedUrl = getMapEmbedUrl();
---

<div class={`map-facade-container card-base ${className}`.trim()} id="map-facade-root">
  <!-- Static / Initial Facade Card -->
  <div class="map-facade-preview" id="map-facade-preview">
    <!-- Map Canvas Graphic Pattern -->
    <div class="map-pattern" aria-hidden="true">
      <div class="map-grid-lines"></div>
      <div class="map-road-h"></div>
      <div class="map-road-v"></div>
    </div>

    <!-- Centered Pin & Clinic Landmark Badge -->
    <div class="map-landmark-badge">
      <div class="pin-pulse" aria-hidden="true"></div>
      <div class="pin-icon-wrap" aria-hidden="true">
        <Icon name="map-pin" size={28} />
      </div>
      <div class="pin-info">
        <strong class="pin-title">Glow & Grace Aesthetics</strong>
        <span class="pin-subtitle">YCDO Ghazi National Hospital, Multan Road</span>
      </div>
    </div>

    <!-- Facade Action Overlay -->
    <div class="facade-action-overlay">
      <p class="facade-note">Click below to load the live Google Map, or get directions directly:</p>
      <div class="facade-buttons">
        <button
          type="button"
          class="btn btn-primary btn-md load-map-btn"
          id="load-map-btn"
          data-embed={embedUrl}
          data-track-event="map_loaded"
          data-track-placement="contact"
        >
          <Icon name="map-pin" size={18} />
          <span>Load Interactive Map</span>
        </button>

        <Button
          href={directionsUrl}
          target="_blank"
          variant="secondary"
          size="md"
          icon="navigation"
        >
          Get Directions
        </Button>
      </div>
      <noscript>
        <div class="no-js-map-notice">
          <p>Interactive map requires JavaScript.</p>
          <a href={searchUrl} target="_blank" rel="noopener noreferrer" class="no-js-link">
            Open Location in Google Maps &rarr;
          </a>
        </div>
      </noscript>
    </div>
  </div>

  <!-- Container for Iframe injection -->
  <div class="map-iframe-container" id="map-iframe-wrapper" style="display: none;"></div>
</div>

<script>
  function initMapFacade() {
    const loadBtn = document.getElementById('load-map-btn');
    const preview = document.getElementById('map-facade-preview');
    const iframeWrapper = document.getElementById('map-iframe-wrapper');

    if (!loadBtn || !preview || !iframeWrapper) return;

    loadBtn.addEventListener('click', () => {
      const embedUrl = loadBtn.getAttribute('data-embed');
      if (!embedUrl) return;

      loadBtn.textContent = 'Loading Map...';

      const iframe = document.createElement('iframe');
      iframe.src = embedUrl;
      iframe.title = 'Google Map Location of Glow & Grace Aesthetics';
      iframe.width = '100%';
      iframe.height = '100%';
      iframe.loading = 'lazy';
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('style', 'border:0; width:100%; height:100%; min-height:420px; border-radius: inherit;');
      iframe.setAttribute('allowfullscreen', '');

      iframe.onerror = () => {
        // Fallback if embed is blocked
        preview.style.display = 'block';
        iframeWrapper.style.display = 'none';
        alert('Could not load Google Maps embed. Please use the Get Directions button.');
      };

      iframeWrapper.innerHTML = '';
      iframeWrapper.appendChild(iframe);
      preview.style.display = 'none';
      iframeWrapper.style.display = 'block';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMapFacade);
  } else {
    initMapFacade();
  }
</script>

<style>
  .map-facade-container {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--white);
    border: 1px solid var(--sand-400);
    min-height: 420px;
    display: flex;
    flex-direction: column;
  }

  .map-facade-preview {
    position: relative;
    width: 100%;
    min-height: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: radial-gradient(circle at center, #FAF7F2 0%, #EAF4EF 100%);
  }

  .map-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    pointer-events: none;
  }

  .map-grid-lines {
    position: absolute;
    inset: 0;
    background-size: 32px 32px;
    background-image:
      linear-gradient(to right, rgba(3, 66, 47, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(3, 66, 47, 0.08) 1px, transparent 1px);
  }

  .map-road-h {
    position: absolute;
    top: 55%;
    left: 0;
    right: 0;
    height: 14px;
    background-color: var(--sand-400);
    opacity: 0.4;
  }

  .map-road-v {
    position: absolute;
    left: 45%;
    top: 0;
    bottom: 0;
    width: 14px;
    background-color: var(--sand-400);
    opacity: 0.4;
  }

  .map-landmark-badge {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 2rem;
  }

  .pin-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: var(--radius-full);
    background-color: var(--green-900);
    color: var(--sand-400);
    box-shadow: 0 8px 24px rgba(3, 66, 47, 0.3);
    margin-bottom: 0.75rem;
    position: relative;
    z-index: 2;
  }

  .pin-pulse {
    position: absolute;
    top: -6px;
    width: 70px;
    height: 70px;
    border-radius: var(--radius-full);
    border: 2px solid var(--green-500);
    opacity: 0.4;
    animation: pulse 2.5s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.9); opacity: 0.7; }
    70% { transform: scale(1.3); opacity: 0; }
    100% { transform: scale(1.3); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pin-pulse {
      animation: none;
    }
  }

  .pin-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--green-900);
    margin-bottom: 0.25rem;
  }

  .pin-subtitle {
    font-size: 0.875rem;
    color: var(--ink-700);
  }

  .facade-action-overlay {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 520px;
    text-align: center;
  }

  .facade-note {
    font-size: 0.875rem;
    color: var(--ink-500);
    margin: 0;
  }

  .facade-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .load-map-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .map-iframe-container {
    width: 100%;
    min-height: 420px;
    height: 100%;
  }

  .no-js-map-notice {
    margin-top: 1rem;
    padding: 0.75rem;
    background-color: var(--white);
    border-radius: var(--radius-sm);
    border: 1px solid var(--sand-400);
  }

  .no-js-link {
    font-weight: 600;
    color: var(--green-700);
  }
</style>
