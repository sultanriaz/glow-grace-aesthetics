---
import Icon from './Icon.astro';
import { getClinicBookingWhatsAppLink, getClinicTelLink } from '../utils/whatsapp';
import { getMapDirectionsUrl } from '../utils/maps';
---

<nav class="sticky-action-bar" aria-label="Quick Actions">
  <div class="sticky-action-container">
    <!-- Call Action -->
    <a
      href={getClinicTelLink()}
      class="sticky-action-btn"
      aria-label="Call clinic directly"
      data-track-event="call_click"
      data-track-placement="hero"
    >
      <div class="sticky-btn-icon">
        <Icon name="phone" size={20} />
      </div>
      <span class="sticky-btn-label">Call</span>
    </a>

    <!-- WhatsApp Action (Primary) -->
    <a
      href={getClinicBookingWhatsAppLink()}
      target="_blank"
      rel="noopener noreferrer"
      class="sticky-action-btn is-primary"
      aria-label="Book appointment on WhatsApp"
      data-track-event="whatsapp_click"
      data-track-placement="floating"
    >
      <div class="sticky-btn-icon">
        <Icon name="whatsapp" size={22} />
      </div>
      <span class="sticky-btn-label">WhatsApp</span>
    </a>

    <!-- Directions Action -->
    <a
      href={getMapDirectionsUrl()}
      target="_blank"
      rel="noopener noreferrer"
      class="sticky-action-btn"
      aria-label="Get Google Maps directions to the clinic"
      data-track-event="directions_click"
      data-track-placement="footer"
    >
      <div class="sticky-btn-icon">
        <Icon name="navigation" size={20} />
      </div>
      <span class="sticky-btn-label">Directions</span>
    </a>
  </div>
</nav>

<style>
  .sticky-action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 900;
    background-color: var(--white);
    border-top: 1px solid var(--sand-300);
    box-shadow: 0 -4px 16px rgba(3, 66, 47, 0.08);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    display: block;
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  /* Automatically hide sticky action bar when mobile nav menu drawer is open */
  :global(body.menu-open) .sticky-action-bar {
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .sticky-action-bar {
      display: none;
    }
  }

  .sticky-action-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: var(--sticky-bar-height);
  }

  .sticky-action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--green-900);
    font-family: var(--font-sans);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    padding: 0.2rem 0.5rem;
    min-height: var(--sticky-bar-height);
  }

  .sticky-action-btn:active {
    transform: scale(0.96);
  }

  .sticky-action-btn:hover {
    background-color: var(--green-50);
  }

  .sticky-btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  .sticky-btn-label {
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Primary WhatsApp Action in Middle */
  .sticky-action-btn.is-primary {
    background-color: var(--green-900);
    color: var(--white);
  }

  .sticky-action-btn.is-primary:hover {
    background-color: var(--color-primary-hover);
  }

  .sticky-action-btn.is-primary .sticky-btn-icon {
    color: #25D366;
  }
</style>
