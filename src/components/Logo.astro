---
import { Image } from 'astro:assets';
import Mark from './Mark.astro';
import { clinic } from '../data/clinic';

interface Props {
  inverted?: boolean;
  class?: string;
  size?: 'sm' | 'md' | 'lg';
  showTagline?: boolean;
}

const {
  inverted = false,
  class: className = '',
  size = 'md',
  showTagline = true
} = Astro.props;

// Detect custom logo dropped into src/assets/brand/logo.{svg,png,webp,jpg}
const brandLogos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/brand/logo.{svg,png,webp,jpg}', { eager: true });
const logoEntries = Object.values(brandLogos);
const customLogo = logoEntries.length > 0 ? logoEntries[0].default : null;
---

<a href="/" class={`brand-logo-link ${className}`.trim()}>
  {customLogo ? (
    <Image
      src={customLogo}
      alt={clinic.name}
      class={`brand-custom-img size-${size}`}
      loading="eager"
      decoding="async"
    />
  ) : (
    <div class={`brand-lockup size-${size} ${inverted ? 'is-inverted' : ''}`}>
      <div class="mark-wrapper">
        <Mark size={size === 'sm' ? 36 : size === 'lg' ? 56 : 44} />
      </div>
      <div class="text-wrapper">
        <span class="wordmark">Glow & Grace</span>
        {showTagline && (
          <span class="tagline">HAIR, BODY, SKIN CARE & AESTHETICS</span>
        )}
      </div>
    </div>
  )}
</a>

<style>
  .brand-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: opacity var(--transition-fast);
  }

  .brand-logo-link:hover {
    opacity: 0.92;
  }

  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .mark-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .text-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--green-900);
    letter-spacing: -0.01em;
  }

  .tagline {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-700);
    margin-top: 0.2rem;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .brand-lockup {
      gap: 0.5rem;
    }
    .wordmark {
      font-size: 1.25rem;
    }
    .tagline {
      font-size: 0.5rem;
      letter-spacing: 0.08em;
    }
  }

  @media (max-width: 360px) {
    .wordmark {
      font-size: 1.15rem;
    }
    .tagline {
      display: none;
    }
  }

  /* Size variations */
  .size-sm .wordmark {
    font-size: 1.25rem;
  }
  .size-sm .tagline {
    font-size: 0.52rem;
  }

  .size-lg .wordmark {
    font-size: 1.85rem;
  }
  .size-lg .tagline {
    font-size: 0.65rem;
  }

  /* Inverted mode (for dark footer / surfaces) */
  .is-inverted .wordmark {
    color: var(--cream-50);
  }
  .is-inverted .tagline {
    color: var(--sand-400);
  }
  .is-inverted :global(.arc-path) {
    fill: var(--cream-50) !important;
  }

  .brand-custom-img {
    height: auto;
    object-fit: contain;
  }
  .brand-custom-img.size-sm {
    max-height: 38px;
  }
  .brand-custom-img.size-md {
    max-height: 48px;
  }
  .brand-custom-img.size-lg {
    max-height: 60px;
  }
</style>
