---
import Button from './Button.astro';
import { getClinicBookingWhatsAppLink, getClinicTelLink } from '../utils/whatsapp';
import { clinic } from '../data/clinic';

interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  eyebrow?: string;
  primaryHref?: string;
  primaryLabel?: string;
  primaryText?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  secondaryText?: string;
  class?: string;
}

const {
  title = "Your skin deserves expert care, not guesswork.",
  subtitle,
  description,
  eyebrow = "BEGIN YOUR AESTHETIC JOURNEY",
  primaryHref = getClinicBookingWhatsAppLink(),
  primaryLabel,
  primaryText,
  secondaryHref = getClinicTelLink(),
  secondaryLabel,
  secondaryText,
  class: className = ''
} = Astro.props;

const resolvedSubtitle = subtitle || description || "Safe, certified, and advanced aesthetic treatments to help you look and feel your best. Speak with our clinical team today to plan your consultation.";
const resolvedPrimaryLabel = primaryLabel || primaryText || "Book Your Appointment";
const resolvedSecondaryLabel = secondaryLabel || secondaryText || `Call ${clinic.phone.display}`;
const isPrimaryWa = primaryHref.includes('wa.me');
---

<section class={`cta-band-section section ${className}`.trim()} aria-label="Book an Appointment">
  <div class="container">
    <div class="cta-card">
      <!-- Decorative Circular Arc Background Elements -->
      <div class="cta-arc-deco" aria-hidden="true"></div>

      <div class="cta-content">
        <span class="cta-eyebrow">{eyebrow}</span>
        <h2 class="cta-title">{title}</h2>
        <p class="cta-subtitle">{resolvedSubtitle}</p>

        <div class="cta-actions">
          <Button
            href={primaryHref}
            target={isPrimaryWa ? "_blank" : undefined}
            variant="secondary"
            size="lg"
            icon={isPrimaryWa ? "whatsapp" : "calendar"}
            class="cta-primary-btn"
          >
            {resolvedPrimaryLabel}
          </Button>

          <Button
            href={secondaryHref}
            variant="outline"
            size="lg"
            icon="phone"
            class="cta-secondary-btn"
          >
            {resolvedSecondaryLabel}
          </Button>
        </div>

        <p class="cta-disclaimer">
          Consultation fee and procedure suitability are determined directly by the doctor during your in-clinic evaluation.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band-section {
    padding-top: clamp(48px, 6vw, 72px);
    padding-bottom: clamp(64px, 8vw, 96px);
  }

  .cta-card {
    background-color: var(--green-900);
    color: var(--cream-50);
    border-radius: var(--radius-lg);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    border: 1px solid var(--sand-400);
    text-align: center;
  }

  /* Decorative soft background arcs */
  .cta-arc-deco {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    border: 40px solid rgba(225, 188, 138, 0.08);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 2;
    max-width: 780px;
    margin: 0 auto;
  }

  .cta-eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--sand-400);
    margin-bottom: 0.75rem;
  }

  .cta-title {
    font-size: var(--text-h2);
    color: var(--cream-50);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .cta-subtitle {
    font-size: var(--text-base);
    color: var(--sand-100);
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .cta-primary-btn {
    background-color: var(--cream-50);
    color: var(--green-900);
    border-color: var(--cream-50);
    font-weight: 600;
  }

  .cta-primary-btn:hover {
    background-color: var(--white);
    color: #022F22;
  }

  .cta-secondary-btn {
    background-color: transparent;
    color: var(--cream-50);
    border-color: var(--sand-400);
  }

  .cta-secondary-btn:hover {
    background-color: rgba(250, 247, 242, 0.1);
    color: var(--white);
    border-color: var(--white);
  }

  .cta-disclaimer {
    font-size: 0.8125rem;
    color: var(--sand-100);
    opacity: 0.85;
    margin: 0;
  }
</style>
