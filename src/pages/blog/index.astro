---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { clinic } from '../../data/clinic';
import { getCollection } from 'astro:content';

let allPosts: any[] = [];
try {
  allPosts = await getCollection('blog');
} catch {
  allPosts = [];
}

const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

// Collect unique tags
const allTags = Array.from(new Set(publishedPosts.flatMap((p) => p.data.tags || []))).sort();

// Format date helper
function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
}

// Estimate reading time helper
function getReadingTime(bodyText: string = ''): number {
  const words = bodyText.split(/\s+/).filter(Boolean).length;
  return Math.max(3, Math.ceil(words / 200));
}

const breadcrumbs = [
  { label: 'Blog' }
];

const breadcrumbsJsonLd = [
  { name: 'Home', item: '/' },
  { name: 'Blog', item: '/blog/' }
];

const pageTitle = `Educational Skincare & Aesthetics Blog | ${clinic.name} DG Khan`;
const pageDescription = `Evidence-based articles on skin care, hair restoration, clinical treatments, and sun protection in Pakistan. Written in plain language for patient education.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbsJsonLd={breadcrumbsJsonLd}
>
  <!-- Hero Section -->
  <header class="blog-hero-section section">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <div class="blog-hero-content">
        <span class="eyebrow">PATIENT EDUCATION &amp; CLINICAL GUIDANCE</span>
        <h1 class="page-title">Aesthetic Medicine, Explained Clearly</h1>
        <p class="lead-text">
          Evidence-based guides to help you understand your skin and hair biology, make confident treatment choices, and separate medical facts from social media marketing.
        </p>
      </div>

      <!-- Tag Filters -->
      {allTags.length > 0 && (
        <div class="tag-filter-bar" role="group" aria-label="Filter articles by topic">
          <button
            type="button"
            class="tag-pill active"
            data-tag="all"
            aria-pressed="true"
          >
            All Topics ({publishedPosts.length})
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              class="tag-pill"
              data-tag={tag.toLowerCase().replace(/\s+/g, '-')}
              aria-pressed="false"
            >
              {tag}
            </button>
          ))}
        </div>
      )}
    </div>
  </header>

  <!-- Blog Grid Section -->
  <main id="main-content" class="blog-grid-section section">
    <div class="container">
      {publishedPosts.length === 0 ? (
        <div class="empty-blog-state">
          <Icon name="check-circle" size={40} />
          <h2>Educational Articles Coming Soon</h2>
          <p>Our clinical team is currently preparing patient guides. Please check back shortly or contact our clinic directly via WhatsApp.</p>
        </div>
      ) : (
        <div class="blog-grid" id="blog-posts-grid">
          {publishedPosts.map((post) => {
            const slug = post.id.replace(/\.md$/, '');
            const postHref = `/blog/${slug}/`;
            const estRead = getReadingTime(post.body || '');
            const postTags = post.data.tags || [];
            const dataTagString = postTags.map((t: string) => t.toLowerCase().replace(/\s+/g, '-')).join(' ');

            return (
              <article class="blog-card" data-tags={dataTagString}>
                <div class="blog-card-meta">
                  <span class="blog-date">{formatDate(post.data.publishedAt)}</span>
                  <span class="meta-dot" aria-hidden="true">•</span>
                  <span class="blog-reading-time">{estRead} min read</span>
                </div>

                <h2 class="blog-card-title">
                  <a href={postHref}>{post.data.title}</a>
                </h2>

                <p class="blog-card-summary">
                  {post.data.description}
                </p>

                <div class="blog-card-footer">
                  <div class="card-tags">
                    {postTags.slice(0, 2).map((tag: string) => (
                      <span class="topic-badge">{tag}</span>
                    ))}
                  </div>

                  <a href={postHref} class="read-more-link" aria-label={`Read article: ${post.data.title}`}>
                    <span>Read Article</span>
                    <Icon name="arrow-right" size={16} />
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <!-- CTA Band -->
  <CtaBand
    eyebrow="PERSONALISED CLINICAL CARE"
    title="Have Questions About Your Skin or Hair?"
    description="Every individual's skin barrier is unique. Schedule an unhurried, one-on-one clinical consultation with our team in Dera Ghazi Khan."
    primaryLabel="Book via WhatsApp"
    primaryHref="/book-appointment/"
    secondaryLabel="Call 0313-4151471"
    secondaryHref="tel:+923134151471"
  />
</BaseLayout>

<script>
  // Progressive tag filter
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.tag-pill');
  const postCards = document.querySelectorAll<HTMLElement>('.blog-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedTag = btn.getAttribute('data-tag');

      // Update button active state
      filterButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');

      // Filter articles
      postCards.forEach((card) => {
        if (!selectedTag || selectedTag === 'all') {
          card.style.display = 'flex';
        } else {
          const cardTags = card.getAttribute('data-tags') || '';
          if (cardTags.includes(selectedTag)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        }
      });
    });
  });
</script>

<style>
  .blog-hero-section {
    background: linear-gradient(180deg, var(--color-surface-sunken) 0%, var(--color-surface) 100%);
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .blog-hero-content {
    max-width: 760px;
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .eyebrow {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
  }

  .lead-text {
    font-size: var(--font-size-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .tag-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .tag-pill {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tag-pill:hover {
    border-color: var(--color-primary-light);
    color: var(--color-text);
  }

  .tag-pill.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  .blog-grid-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-light);
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .meta-dot {
    color: var(--color-border);
  }

  .blog-card-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 var(--space-3) 0;
  }

  .blog-card-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .blog-card-title a:hover {
    color: var(--color-primary);
  }

  .blog-card-summary {
    font-size: var(--font-size-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-5) 0;
    flex-grow: 1;
  }

  .blog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .card-tags {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .topic-badge {
    display: inline-block;
    padding: 2px var(--space-2);
    font-size: 11px;
    font-weight: 600;
    background-color: var(--color-surface-sunken);
    color: var(--color-primary);
    border-radius: var(--radius-sm);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: gap var(--transition-fast);
  }

  .read-more-link:hover {
    gap: var(--space-2);
    text-decoration: underline;
  }

  .empty-blog-state {
    text-align: center;
    max-width: 500px;
    margin: var(--space-12) auto;
    padding: var(--space-8);
    background-color: var(--color-surface-sunken);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
