---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { clinic } from '../../data/clinic';
import { getClinicBookingWhatsAppLink } from '../../utils/whatsapp';
import { getCanonicalUrl } from '../../utils/seo';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const allServices = await getCollection('services');

  return allPosts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post, allServices }
  }));
}

const { post, allServices } = Astro.props;
const { Content, headings } = await render(post);

const currentSlug = post.id.replace(/\.md$/, '');
const articleUrl = getCanonicalUrl(Astro.url.pathname);

// Reading time calculation
const wordCount = (post.body || '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(3, Math.ceil(wordCount / 200));

// Format date
function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
}

// Filter H2 headings for Table of Contents
const tocHeadings = headings.filter((h) => h.depth === 2);

// Resolve related services
const relatedServices = allServices.filter((s) => {
  const serviceSlug = s.id.replace(/\.md$/, '');
  return (post.data.relatedServices || []).includes(serviceSlug);
});

const breadcrumbs = [
  { label: 'Blog', href: '/blog/' },
  { label: post.data.title }
];

const breadcrumbsJsonLd = [
  { name: 'Home', item: '/' },
  { name: 'Blog', item: '/blog/' },
  { name: post.data.title, item: `/blog/${currentSlug}/` }
];

const pageTitle = `${post.data.title} | ${clinic.shortName} Blog`;
const pageDescription = post.data.description;

const articleJsonLd = {
  title: post.data.title,
  description: post.data.description,
  publishedAt: post.data.publishedAt,
  updatedAt: post.data.updatedAt || post.data.publishedAt,
  url: articleUrl,
  tags: post.data.tags || []
};

const waBookingLink = getClinicBookingWhatsAppLink();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbsJsonLd={breadcrumbsJsonLd}
  jsonLdType="article"
  articleJsonLd={articleJsonLd}
  ogType="article"
>
  <!-- Article Header Section -->
  <header class="article-hero-section section">
    <div class="container container--narrow">
      <Breadcrumbs items={breadcrumbs} />

      <div class="article-header-meta">
        <div class="article-tags">
          {(post.data.tags || []).map((tag: string) => (
            <span class="topic-badge">{tag}</span>
          ))}
        </div>
        <div class="article-read-stats">
          <span>{formatDate(post.data.publishedAt)}</span>
          <span class="meta-dot" aria-hidden="true">•</span>
          <span>{readingTime} min read</span>
        </div>
      </div>

      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-lead">{post.data.description}</p>

      <!-- Reviewer Trust Card -->
      <div class="review-status-card">
        <Icon name="check-circle" size={20} />
        <div>
          <span class="review-label">Clinical Education Notice:</span>
          <span class="review-text">Reviewed for medical accuracy and patient clarity by the clinical team at Glow &amp; Grace Aesthetics. Written in accordance with ethical medical communication guidelines.</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Article Body Layout -->
  <main id="main-content" class="article-content-section section">
    <div class="container">
      <div class="article-layout">
        <!-- Main Prose Column -->
        <div class="article-main">
          {tocHeadings.length > 0 && (
            <nav class="table-of-contents" aria-label="Table of contents">
              <h2 class="toc-title">Contents</h2>
              <ol class="toc-list">
                {tocHeadings.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          <div class="prose">
            <Content />
          </div>

          <!-- Clinic Author & Trust Box -->
          <aside class="author-trust-box" aria-label="About the Publisher">
            <div class="author-avatar-badge">
              <span>GG</span>
            </div>
            <div class="author-info">
              <h3 class="author-name">Glow &amp; Grace Aesthetics</h3>
              <p class="author-role">Medical Aesthetics Clinic • Dera Ghazi Khan, Punjab</p>
              <p class="author-bio">
                "Your skin deserves expert care, not guesswork." Safe, certified, and patient-first aesthetic treatments delivered under strict clinical standards. Located at YCDO Ghazi National Hospital, Samina Chowk, Multan Road.
              </p>
              <div class="author-actions">
                <Button href="/book-appointment/" variant="primary" size="sm">
                  Request Consultation
                </Button>
                <Button href={waBookingLink} variant="outline" size="sm">
                  WhatsApp Clinic
                </Button>
              </div>
            </div>
          </aside>
        </div>

        <!-- Sticky Sidebar on Desktop -->
        <aside class="article-sidebar">
          <div class="sidebar-sticky-wrapper">
            <!-- Booking Card -->
            <div class="sidebar-consultation-card">
              <h3 class="sidebar-card-title">Schedule a Consultation</h3>
              <p class="sidebar-card-text">
                Every skin journey begins with a thorough, unhurried assessment. Speak directly with our clinical team.
              </p>
              <Button href="/book-appointment/" variant="primary" fullWidth size="md">
                Book Appointment
              </Button>
              <a href={waBookingLink} class="sidebar-wa-link" target="_blank" rel="noopener noreferrer">
                <Icon name="whatsapp" size={16} />
                <span>Chat on WhatsApp</span>
              </a>
            </div>

            <!-- Quick Jump (desktop only) -->
            {tocHeadings.length > 0 && (
              <div class="sidebar-toc-card">
                <h4 class="sidebar-toc-heading">On this page</h4>
                <ul class="sidebar-toc-list">
                  {tocHeadings.map((heading) => (
                    <li>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </aside>
      </div>

      <!-- Related Services Section -->
      {relatedServices.length > 0 && (
        <section class="related-services-section" aria-labelledby="related-services-title">
          <div class="related-services-header">
            <span class="eyebrow">CLINICAL TREATMENTS</span>
            <h2 id="related-services-title" class="related-title">Related Aesthetic Services</h2>
            <p class="related-subtitle">Explore clinical procedures related to the topics discussed in this educational article.</p>
          </div>

          <div class="services-grid">
            {relatedServices.map((service) => (
              <ServiceCard
                slug={service.id.replace(/\.md$/, '')}
                title={service.data.title}
                tagline={service.data.tagline || service.data.summary}
                category={service.data.category}
                icon={service.data.icon}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  <!-- CTA Band -->
  <CtaBand
    eyebrow="ETHICAL MEDICAL AESTHETICS"
    title="Ready to Begin Your Skin Care Journey?"
    description="Receive compassionate, evidence-based care tailored to your unique skin type in Dera Ghazi Khan."
    primaryLabel="Book via WhatsApp"
    primaryHref="/book-appointment/"
    secondaryLabel="Call 0313-4151471"
    secondaryHref="tel:+923134151471"
  />
</BaseLayout>

<style>
  .article-hero-section {
    background: linear-gradient(180deg, var(--color-surface-sunken) 0%, var(--color-surface) 100%);
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .container--narrow {
    max-width: 820px;
  }

  .article-header-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .article-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .topic-badge {
    display: inline-block;
    padding: 2px var(--space-3);
    font-size: var(--font-size-xs);
    font-weight: 600;
    background-color: var(--color-surface-sunken);
    color: var(--color-primary);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .article-read-stats {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .meta-dot {
    color: var(--color-border);
  }

  .article-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
    margin: var(--space-2) 0 var(--space-4) 0;
  }

  .article-lead {
    font-size: var(--font-size-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-5) 0;
  }

  .review-status-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .review-status-card :global(svg) {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .review-label {
    display: block;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 2px;
  }

  .review-text {
    line-height: 1.5;
  }

  .article-content-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 992px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }

  .table-of-contents {
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-8);
  }

  .toc-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
  }

  .toc-list {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .toc-list a {
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    text-decoration: none;
    line-height: 1.4;
  }

  .toc-list a:hover {
    text-decoration: underline;
  }

  /* Prose typography styling */
  .prose {
    font-size: var(--font-size-base);
    line-height: 1.75;
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.5vw, 1.75rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .prose :global(h2:first-of-type) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .prose :global(h3) {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .prose :global(ul), .prose :global(ol) {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .author-trust-box {
    display: flex;
    gap: var(--space-4);
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-top: var(--space-10);
  }

  .author-avatar-badge {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--font-size-lg);
    flex-shrink: 0;
  }

  .author-info {
    flex-grow: 1;
  }

  .author-name {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 2px 0;
  }

  .author-role {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3) 0;
  }

  .author-bio {
    font-size: var(--font-size-sm);
    line-height: 1.6;
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }

  .author-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* Sticky sidebar */
  .sidebar-sticky-wrapper {
    position: sticky;
    top: calc(var(--header-height, 70px) + var(--space-4));
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .sidebar-consultation-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
  }

  .sidebar-card-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
  }

  .sidebar-card-text {
    font-size: var(--font-size-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4) 0;
  }

  .sidebar-wa-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .sidebar-wa-link:hover {
    text-decoration: underline;
  }

  .sidebar-toc-card {
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .sidebar-toc-heading {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3) 0;
  }

  .sidebar-toc-list {
    margin: 0;
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar-toc-list a {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    text-decoration: none;
    line-height: 1.4;
  }

  .sidebar-toc-list a:hover {
    color: var(--color-primary);
  }

  /* Related services */
  .related-services-section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .related-services-header {
    max-width: 600px;
    margin-bottom: var(--space-6);
  }

  .eyebrow {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: var(--space-1);
  }

  .related-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: 600;
    margin: 0 0 var(--space-2) 0;
  }

  .related-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .author-trust-box {
      flex-direction: column;
    }
  }
</style>
