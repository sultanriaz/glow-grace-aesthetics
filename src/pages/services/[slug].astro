---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import { clinic } from '../../data/clinic';
import { categories } from '../../data/categories';
import { getServiceBookingWhatsAppLink, getClinicTelLink } from '../../utils/whatsapp';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allServices = await getCollection('services');
  return allServices.map((service) => ({
    params: { slug: service.id.replace(/\.md$/, '') },
    props: { service, allServices }
  }));
}

const { service, allServices } = Astro.props;
const { Content } = await render(service);

const currentSlug = service.id.replace(/\.md$/, '');
const categoryObj = categories.find((c) => c.slug === service.data.category);
const categoryName = categoryObj ? categoryObj.name : service.data.category;
const categoryHref = `/services/category/${service.data.category}/`;

// Related services (same category, excluding self, up to 3)
const relatedServices = allServices
  .filter((s) => s.data.category === service.data.category && s.id !== service.id)
  .slice(0, 3);

const waBookingLink = getServiceBookingWhatsAppLink(service.data.title);
const bookAppointmentHref = `/book-appointment/?service=${currentSlug}`;

const pageTitle = service.data.seoTitle || `${service.data.title} in DG Khan | ${clinic.shortName}`;
const pageDescription = service.data.seoDescription || service.data.summary;

const breadcrumbs = [
  { label: 'Services', href: '/services/' },
  { label: categoryName, href: categoryHref },
  { label: service.data.title }
];

const serviceJsonLd = {
  title: service.data.title,
  description: service.data.summary,
  category: categoryName,
  url: Astro.url.href
};

const breadcrumbsJsonLd = [
  { name: 'Home', item: '/' },
  { name: 'Services', item: '/services/' },
  { name: categoryName, item: categoryHref },
  { name: service.data.title, item: Astro.url.pathname }
];

const isMoleRemoval = currentSlug === 'mole-wart-removal';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonLdType="service"
  serviceJsonLd={serviceJsonLd}
  breadcrumbsJsonLd={breadcrumbsJsonLd}
  faqsJsonLd={service.data.faqs}
>
  <!-- Service Hero Section -->
  <header class="service-hero-section section">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <div class="service-hero-grid">
        <div class="service-hero-content">
          <a href={categoryHref} class="service-category-badge">
            <Icon name={categoryObj?.icon || 'sparkles'} size={16} />
            <span>{categoryName}</span>
          </a>

          <h1 class="service-title">{service.data.title}</h1>
          <p class="service-tagline">{service.data.tagline}</p>

          <p class="service-summary-lead">{service.data.summary}</p>

          <div class="service-hero-actions">
            <Button
              href={bookAppointmentHref}
              variant="primary"
              size="lg"
              icon="calendar"
              class="service-primary-btn"
            >
              Book Appointment
            </Button>

            <Button
              href={waBookingLink}
              target="_blank"
              variant="secondary"
              size="lg"
              icon="whatsapp"
            >
              Consult on WhatsApp
            </Button>
          </div>
        </div>

        <!-- Service Trust & Quick Facts Card -->
        <div class="service-hero-card-wrap">
          <div class="service-facts-card card-base">
            <h2 class="facts-title">Clinical Care Overview</h2>
            <ul class="facts-list" role="list">
              <li class="fact-item">
                <Icon name="shield-check" size={18} class="fact-icon" />
                <div>
                  <strong>Evaluation</strong>
                  <p>In-person doctor assessment required</p>
                </div>
              </li>
              <li class="fact-item">
                <Icon name="clock" size={18} class="fact-icon" />
                <div>
                  <strong>Availability</strong>
                  <p>Monday to Saturday, 10 AM to 10 PM</p>
                </div>
              </li>
              <li class="fact-item">
                <Icon name="map-pin" size={18} class="fact-icon" />
                <div>
                  <strong>Facility</strong>
                  <p>YCDO Ghazi National Hospital, DG Khan</p>
                </div>
              </li>
              <li class="fact-item">
                <Icon name="user" size={18} class="fact-icon" />
                <div>
                  <strong>Suitability</strong>
                  <p>Decided by the physician during consultation</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Sticky Desktop In-Page Navigation Bar -->
  <nav class="inpage-nav-bar" aria-label="Page Sections Navigation">
    <div class="container inpage-nav-container">
      <ul class="inpage-nav-list" role="list">
        <li><a href="#overview" class="inpage-nav-link">Overview</a></li>
        {service.data.whatToExpect.length > 0 && (
          <li><a href="#what-to-expect" class="inpage-nav-link">What to Expect</a></li>
        )}
        {service.data.aftercare.length > 0 && (
          <li><a href="#aftercare" class="inpage-nav-link">Aftercare</a></li>
        )}
        {service.data.considerations.length > 0 && (
          <li><a href="#considerations" class="inpage-nav-link">Considerations</a></li>
        )}
        {service.data.faqs.length > 0 && (
          <li><a href="#faqs" class="inpage-nav-link">FAQs</a></li>
        )}
      </ul>
      <a href={bookAppointmentHref} class="inpage-nav-cta">
        Book Appointment &rarr;
      </a>
    </div>
  </nav>

  <!-- Special Clinical Advisory for Mole & Wart Removal -->
  {isMoleRemoval && (
    <div class="container mole-alert-container">
      <div class="mole-warning-banner" role="alert">
        <div class="alert-icon" aria-hidden="true">
          <Icon name="shield-alert" size={24} />
        </div>
        <div>
          <strong class="alert-title">Important Medical Precaution:</strong>
          <p class="alert-desc">
            Any mole that changes in size, shape, borders, or colour, or exhibits itching or bleeding, must be clinically examined by a doctor to rule out atypical lesions before any cosmetic removal is considered.
          </p>
        </div>
      </div>
    </div>
  )}

  <!-- Service Details Section: Layout Grid with Content + Sidebar -->
  <section class="section service-body-section" aria-label="Treatment Information">
    <div class="container">
      <div class="service-layout-grid">
        <!-- Main Clinical Body Column -->
        <div class="service-main-content">
          <!-- Overview & Mechanism Block -->
          <article id="overview" class="content-block card-base">
            <div class="prose-treatment">
              <Content />
            </div>

            <!-- Standard Consultation Medical Note -->
            <div class="consultation-medical-notice">
              <Icon name="shield-check" size={20} class="notice-icon" />
              <p>
                <strong>Medical Notice:</strong> Suitability is decided by the doctor after a consultation. Results vary from person to person based on biological characteristics, skin type, and post-procedure care adherence.
              </p>
            </div>
          </article>

          <!-- Benefits Block -->
          <div class="content-block card-base">
            <h2 class="content-heading">Key Clinical Advantages</h2>
            <ul class="benefits-grid-list" role="list">
              {service.data.benefits.map((benefit) => (
                <li class="benefit-card-item">
                  <div class="benefit-check-icon" aria-hidden="true">
                    <Icon name="check" size={16} />
                  </div>
                  <span class="benefit-text">{benefit}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Ideal For Block -->
          <div class="content-block card-base">
            <h2 class="content-heading">Who is this Treatment Ideal For?</h2>
            <ul class="ideal-for-list" role="list">
              {service.data.idealFor.map((target) => (
                <li class="ideal-item">
                  <div class="ideal-bullet" aria-hidden="true">
                    <Icon name="sparkles" size={16} />
                  </div>
                  <span class="ideal-text">{target}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- What to Expect Block -->
          {service.data.whatToExpect.length > 0 && (
            <div id="what-to-expect" class="content-block card-base">
              <h2 class="content-heading">What to Expect During Your Visit</h2>
              <ol class="step-guide-list" role="list">
                {service.data.whatToExpect.map((step, idx) => (
                  <li class="step-guide-item">
                    <span class="step-guide-num" aria-hidden="true">0{idx + 1}</span>
                    <div class="step-guide-text">{step}</div>
                  </li>
                ))}
              </ol>
            </div>
          )}

          <!-- Aftercare Block -->
          {service.data.aftercare.length > 0 && (
            <div id="aftercare" class="content-block card-base">
              <h2 class="content-heading">Essential Aftercare & Recovery Guidelines</h2>
              <ul class="guidelines-list" role="list">
                {service.data.aftercare.map((tip) => (
                  <li class="guideline-item">
                    <div class="guideline-icon" aria-hidden="true">
                      <Icon name="check" size={16} />
                    </div>
                    <span class="guideline-text">{tip}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Considerations Block -->
          {service.data.considerations.length > 0 && (
            <div id="considerations" class="content-block card-base">
              <h2 class="content-heading">Important Clinical Considerations</h2>
              <ul class="considerations-list" role="list">
                {service.data.considerations.map((item) => (
                  <li class="consideration-item">
                    <div class="consideration-bullet" aria-hidden="true">
                      <Icon name="shield-check" size={16} />
                    </div>
                    <span class="consideration-text">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- FAQs Accordion Block -->
          {service.data.faqs.length > 0 && (
            <div id="faqs" class="content-block card-base">
              <h2 class="content-heading">Frequently Asked Questions</h2>
              <p class="faq-section-lead">
                Doctor-reviewed guidance regarding {service.data.title}.
              </p>

              <div class="faqs-accordion-group">
                {service.data.faqs.map((faq) => (
                  <details class="faq-accordion-item">
                    <summary class="faq-summary">
                      <span class="faq-question-text">{faq.question}</span>
                      <span class="faq-indicator" aria-hidden="true">
                        <Icon name="chevron-down" size={18} />
                      </span>
                    </summary>
                    <div class="faq-answer-body">
                      <p>{faq.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sticky Sidebar CTA Card -->
        <aside class="service-sidebar">
          <div class="sticky-inquiry-card card-base">
            <h3 class="inquiry-card-title">Book for {service.data.title}</h3>
            <p class="inquiry-card-desc">
              Request an appointment online or contact our clinic directly on WhatsApp to check doctor availability.
            </p>

            <Button
              href={bookAppointmentHref}
              variant="primary"
              size="md"
              icon="calendar"
              class="w-full mb-3"
            >
              Book Appointment
            </Button>

            <Button
              href={waBookingLink}
              target="_blank"
              variant="secondary"
              size="md"
              icon="whatsapp"
              class="w-full mb-3"
            >
              Chat on WhatsApp
            </Button>

            <Button
              href={getClinicTelLink()}
              variant="ghost"
              size="md"
              icon="phone"
              class="w-full"
            >
              Call {clinic.phone.display}
            </Button>

            <hr class="inquiry-divider" />

            <div class="inquiry-meta-item">
              <span class="meta-label">Category:</span>
              <a href={categoryHref} class="meta-link">{categoryName} &rarr;</a>
            </div>

            <div class="inquiry-tags">
              <span class="tags-label">Clinical Focus:</span>
              <div class="tags-wrap">
                {service.data.tags.map((tag) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Related Services in Same Category -->
  {relatedServices.length > 0 && (
    <section class="section related-services-section" aria-label="Related Treatments">
      <div class="container">
        <SectionHeading
          eyebrow={`EXPLORE MORE IN ${categoryName.toUpperCase()}`}
          title="Related Clinical Procedures"
          description="Discover complementary aesthetic options within this specialised division."
        />

        <div class="related-services-grid">
          {relatedServices.map((rel) => (
            <div class="fade-up-item">
              <ServiceCard
                slug={rel.id.replace(/\.md$/, '')}
                title={rel.data.title}
                tagline={rel.data.tagline}
                category={categoryName}
                icon={rel.data.icon}
                featured={rel.data.featured}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Final CTA Band -->
  <CtaBand
    title={`Ready to discuss ${service.data.title}?`}
    subtitle="Our doctor conducts personalised evaluations in Dera Ghazi Khan to map the safest, most effective pathway for your aesthetic goals."
    primaryHref={bookAppointmentHref}
    primaryText="Book Appointment Online"
    secondaryHref={waBookingLink}
    secondaryText="Chat on WhatsApp"
  />
</BaseLayout>

<style>
  .service-hero-section {
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(32px, 5vw, 48px);
    background-color: var(--green-50);
    border-bottom: 1px solid var(--sand-100);
  }

  .service-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .service-hero-grid {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 3.5rem;
    }
  }

  .service-category-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--green-700);
    background-color: var(--white);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--sand-400);
    margin-bottom: 1rem;
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .service-category-badge:hover {
    background-color: var(--green-100);
    border-color: var(--green-600);
  }

  .service-title {
    font-size: var(--text-h1);
    color: var(--green-900);
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .service-tagline {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.5vw + 0.8rem, 1.6rem);
    color: var(--green-700);
    font-style: italic;
    line-height: 1.4;
    margin-bottom: 1.25rem;
  }

  .service-summary-lead {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 1.75rem;
    max-width: 60ch;
  }

  .service-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .service-facts-card {
    background-color: var(--white);
    border: 1px solid var(--sand-300);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: var(--shadow-sm);
  }

  .facts-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--green-900);
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--sand-200);
    padding-bottom: 0.75rem;
  }

  .facts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .fact-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .fact-icon {
    color: var(--green-700);
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .fact-item strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--green-900);
    line-height: 1.3;
  }

  .fact-item p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* In-page Sticky Nav */
  .inpage-nav-bar {
    position: sticky;
    top: var(--header-height, 72px);
    z-index: 30;
    background-color: var(--white);
    border-bottom: 1px solid var(--sand-300);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    backdrop-filter: blur(8px);
  }

  .inpage-nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
  }

  .inpage-nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .inpage-nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-body);
    text-decoration: none;
    padding: 0.4rem 0.2rem;
    border-bottom: 2px solid transparent;
    transition: var(--transition-fast);
  }

  .inpage-nav-link:hover,
  .inpage-nav-link:focus-visible {
    color: var(--green-800);
    border-bottom-color: var(--gold-500);
  }

  .inpage-nav-cta {
    display: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--green-800);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .inpage-nav-cta:hover {
    color: var(--gold-600);
  }

  @media (min-width: 768px) {
    .inpage-nav-cta {
      display: inline-flex;
    }
  }

  /* Mole Alert Banner */
  .mole-alert-container {
    padding-top: 2rem;
  }

  .mole-warning-banner {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 1.5rem;
    background-color: #FEF3C7;
    border: 1px solid #F59E0B;
    border-radius: var(--radius-md);
    color: #92400E;
  }

  .alert-icon {
    flex-shrink: 0;
    color: #B45309;
    margin-top: 0.15rem;
  }

  .alert-title {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: #78350F;
  }

  .alert-desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Layout Grid */
  .service-body-section {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .service-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .service-layout-grid {
      grid-template-columns: 1fr 340px;
      gap: 3.5rem;
    }
  }

  .service-main-content {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .content-block {
    background-color: var(--white);
    border: 1px solid var(--sand-200);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    scroll-margin-top: calc(var(--header-height, 72px) + 50px);
  }

  .content-heading {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    color: var(--green-900);
    margin-bottom: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .prose-treatment {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-body);
  }

  .prose-treatment :global(h2) {
    font-size: 1.35rem;
    color: var(--green-900);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose-treatment :global(h2:first-of-type) {
    margin-top: 0;
  }

  .prose-treatment :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose-treatment :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose-treatment :global(li) {
    margin-bottom: 0.5rem;
  }

  .consultation-medical-notice {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1rem 1.25rem;
    background-color: var(--sand-100);
    border-left: 3px solid var(--green-700);
    border-radius: var(--radius-sm);
    margin-top: 1.5rem;
  }

  .notice-icon {
    color: var(--green-700);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .consultation-medical-notice p {
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
    color: var(--text-muted);
  }

  /* Benefits Grid */
  .benefits-grid-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .benefits-grid-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .benefit-card-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    background-color: var(--green-50);
    border: 1px solid var(--sand-200);
    border-radius: var(--radius-md);
  }

  .benefit-check-icon {
    color: var(--green-700);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .benefit-text {
    font-size: 0.9375rem;
    color: var(--green-900);
    font-weight: 500;
    line-height: 1.4;
  }

  /* Ideal For List */
  .ideal-for-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .ideal-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .ideal-bullet {
    color: var(--gold-600);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .ideal-text {
    font-size: 0.9375rem;
    color: var(--text-body);
    line-height: 1.5;
  }

  /* Step Guide List (What to expect) */
  .step-guide-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .step-guide-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1rem 1.25rem;
    background-color: var(--sand-50);
    border: 1px solid var(--sand-200);
    border-radius: var(--radius-md);
  }

  .step-guide-num {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--green-800);
    line-height: 1;
