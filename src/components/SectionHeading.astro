---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'center',
  class: className = ''
} = Astro.props;
---

<div class={`section-heading align-${align} ${className}`.trim()}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="section-title">{title}</h2>
  {description && <p class="section-description">{description}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    max-width: 760px;
  }

  .align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .align-left {
    text-align: left;
  }

  .section-title {
    font-size: var(--text-h2);
    color: var(--green-900);
    line-height: 1.2;
    margin-top: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .section-description {
    font-size: var(--text-base);
    color: var(--ink-500);
    line-height: 1.6;
    margin-top: 0.5rem;
  }
</style>
