---
import { getCanonicalUrl, getOgImageUrl, defaultSeo } from '../utils/seo';
import { clinic } from '../data/clinic';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleSection?: string;
}

const {
  title = defaultSeo.title,
  description = defaultSeo.description,
  canonical,
  ogType = 'website',
  ogImage,
  ogImageAlt = defaultSeo.ogImageAlt,
  noindex = false,
  articlePublishedTime,
  articleModifiedTime,
  articleSection
} = Astro.props;

const currentPath = Astro.url.pathname;
const resolvedCanonical = canonical || getCanonicalUrl(currentPath);

// Auto-determine per-page OG image if not explicitly provided
function getAutoOgImage(path: string): string {
  const clean = path.replace(/^\/|\/$/g, '');
  if (!clean) return '/og/og-home.jpg';
  if (clean === 'about') return '/og/og-about.jpg';
  if (clean === 'services') return '/og/og-services.jpg';
  if (clean.startsWith('services/category/')) {
    const cat = clean.replace('services/category/', '');
    return `/og/og-category-${cat}.jpg`;
  }
  if (clean.startsWith('services/')) {
    const slug = clean.replace('services/', '');
    return `/og/og-service-${slug}.jpg`;
  }
  if (clean === 'faq') return '/og/og-faq.jpg';
  if (clean === 'book-appointment') return '/og/og-book-appointment.jpg';
  if (clean === 'contact') return '/og/og-contact.jpg';
  if (clean === 'blog') return '/og/og-blog.jpg';
  if (clean.startsWith('blog/')) {
    const slug = clean.replace('blog/', '');
    return `/og/og-blog-${slug}.jpg`;
  }
  if (clean === 'privacy') return '/og/og-privacy.jpg';
  if (clean === 'terms') return '/og/og-terms.jpg';
  if (clean === 'medical-disclaimer') return '/og/og-medical-disclaimer.jpg';
  return '/og/og-default.jpg';
}

const chosenOgImagePath = ogImage || getAutoOgImage(currentPath);
const resolvedOgImage = chosenOgImagePath.startsWith('http')
  ? chosenOgImagePath
  : getOgImageUrl(chosenOgImagePath);

const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || (typeof process !== 'undefined' ? process.env.PUBLIC_GSC_VERIFICATION : undefined);
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION || (typeof process !== 'undefined' ? process.env.PUBLIC_BING_VERIFICATION : undefined);
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={resolvedCanonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow" />}

<meta name="author" content={clinic.name} />
<meta name="theme-color" content="#03422F" />
<meta name="format-detection" content="telephone=no" />

<!-- Search Engine Verification -->
{gscVerification && <meta name="google-site-verification" content={gscVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:secure_url" content={resolvedOgImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content="en_PK" />
<meta property="og:site_name" content={clinic.name} />

<!-- Article Metadata for Blog Posts -->
{ogType === 'article' && articlePublishedTime && (
  <meta property="article:published_time" content={articlePublishedTime} />
)}
{ogType === 'article' && articleModifiedTime && (
  <meta property="article:modified_time" content={articleModifiedTime} />
)}
{ogType === 'article' && articleSection && (
  <meta property="article:section" content={articleSection} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={resolvedCanonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Favicon & App Icons -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
