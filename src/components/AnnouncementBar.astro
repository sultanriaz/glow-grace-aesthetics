---
import { clinic } from '../data/clinic';
import Icon from './Icon.astro';
import { getClinicTelLink } from '../utils/whatsapp';
---

<div class="announcement-bar" role="region" aria-label="Clinic hours and contact">
  <div class="container announcement-container">
    <div class="announcement-item">
      <Icon name="clock" size={14} class="announcement-icon" />
      <span>Open Mon – Sat: 10:00 AM – 10:00 PM</span>
    </div>
    <div class="announcement-separator" aria-hidden="true">•</div>
    <div class="announcement-item">
      <Icon name="map-pin" size={14} class="announcement-icon" />
      <span>YCDO Ghazi National Hospital, Multan Road, DG Khan</span>
    </div>
    <div class="announcement-spacer"></div>
    <a href={getClinicTelLink()} class="announcement-phone">
      <Icon name="phone" size={14} class="announcement-icon" />
      <span>Call: {clinic.phone.display}</span>
    </a>
  </div>
</div>

<style>
  .announcement-bar {
    background-color: var(--green-900);
    color: var(--cream-50);
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(225, 188, 138, 0.25);
    display: none;
  }

  @media (min-width: 1024px) {
    .announcement-bar {
      display: block;
    }
  }

  .announcement-container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .announcement-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sand-100);
  }

  .announcement-separator {
    color: var(--sand-400);
    opacity: 0.6;
  }

  .announcement-spacer {
    flex: 1;
  }

  .announcement-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--cream-50);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .announcement-phone:hover {
    color: var(--sand-400);
  }

  .announcement-icon {
    color: var(--sand-400);
  }
</style>
